{
  "name": "@jaewangl/qutex",
  "version": "0.3.0",
  "private": false,
  "description": "Temml-based MathML and standalone SVG with an OpenType math font and country-specific school notation (ko, ja)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./src/browser.mjs",
      "default": "./src/index.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.mjs"
    },
    "./svg": {
      "types": "./types/svg.d.ts",
      "default": "./src/svg.mjs"
    },
    "./font": {
      "types": "./types/font.d.ts",
      "default": "./src/font.mjs"
    },
    "./qutex.css": "./dist/qutex.css",
    "./qutex-lite.css": "./dist/qutex-lite.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "bin": {
    "qutex": "./src/cli.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "specimen": "node tools/specimen.mjs",
    "start": "node src/server.mjs",
    "build:native": "cargo build --manifest-path crates/Cargo.toml --release",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@mathjax/mathjax-modern-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@napi-rs/canvas": "^1.0.0",
    "fontkit": "^2.0.4",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.56.1",
    "svgcanvas": "^2.6.0"
  },
  "peerDependenciesMeta": {
    "@mathjax/mathjax-modern-font": {
      "optional": true
    },
    "@mathjax/src": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "fontkit": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "svgcanvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mathjax/mathjax-modern-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "1.0.0",
    "fontkit": "2.0.4",
    "jsdom": "26.1.0",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.56.1",
    "svgcanvas": "2.6.0",
    "esbuild": "0.25.12",
    "saxes": "6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaeWangL/qutex.git"
  },
  "homepage": "https://github.com/JaeWangL/qutex#readme",
  "bugs": {
    "url": "https://github.com/JaeWangL/qutex/issues"
  },
  "keywords": [
    "math",
    "latex",
    "mathml",
    "svg",
    "temml",
    "equation",
    "korean",
    "locale",
    "japanese"
  ],
  "publishConfig": {
    "access": "public"
  },
  "jsdelivr": "dist/qutex.min.js",
  "unpkg": "dist/qutex.min.js",
  "style": "dist/qutex.css",
  "main": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "dist/*.js",
    "dist/*.mjs",
    "dist/*.map",
    "dist/*.txt",
    "dist/*.css",
    "dist/*.otf",
    "dist/*.woff2",
    "dist/manifest.json",
    "dist/licenses/",
    "fonts/*.otf",
    "fonts/*.woff2",
    "fonts/*.json",
    "fonts/*.md",
    "fonts/*.txt",
    "fonts/upstream/latin-modern-math/",
    "fonts/upstream/noto-serif-kr/OFL.txt",
    "fonts/upstream/noto-serif-kr/SOURCE.json",
    "fonts/upstream/katex-script/",
    "vendor/temml/dist/temml.mjs",
    "vendor/temml/LICENSE",
    "vendor/temml/package.json",
    "UPSTREAM.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/",
    "crates/Cargo.toml",
    "crates/Cargo.lock",
    "crates/qutex-font-outline/Cargo.toml",
    "crates/qutex-font-outline/src/",
    "fonts/upstream/noto-serif-kr/*.ttf"
  ]
}
